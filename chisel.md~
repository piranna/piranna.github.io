COPY --from=chiseler /rootfs/ /

COPY --from=etcfiles --chown=nonroot:nonroot /home/nonroot /home/nonroot
COPY --from=etcfiles /etc/passwd /etc/passwd
COPY --from=etcfiles /etc/group  /etc/group

